generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountType {
  PAYMENT
  SAVINGS
}

enum AccountStatus {
  ACTIVE
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReferenceType {
  OPENING_DEPOSIT
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransactionStatus {
  COMPLETED
}

enum TransferStatus {
  COMPLETED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @map("user_id")
  email        String   @unique @db.VarChar(254)
  fullName     String   @map("full_name") @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  accounts  BankAccount[]
  transfers Transfer[]

  @@map("users")
}

model BankAccount {
  id             String        @id @default(uuid()) @map("id")
  userId         String        @map("user_id")
  accountNumber  String        @unique @map("account_number") @db.VarChar(20)
  accountName    String        @map("account_name") @db.VarChar(100)
  accountType    AccountType   @map("account_type")
  currentBalance Decimal       @default(0) @map("current_balance") @db.Decimal(18, 0)
  currency       String        @default("VND") @map("currency") @db.Char(3)
  status         AccountStatus @default(ACTIVE)
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]
  transfersOut Transfer[]             @relation("SourceAccount")
  transfersIn  Transfer[]             @relation("DestinationAccount")

  @@index([userId, status, createdAt(sort: Desc)], name: "idx_accounts_user_status_created")
  @@map("bank_accounts")
}

model FinancialTransaction {
  id              String            @id @default(uuid())
  accountId       String            @map("account_id")
  transferId      String?           @map("transfer_id")
  transactionType TransactionType   @map("transaction_type")
  referenceType   ReferenceType     @map("reference_type")
  amount          Decimal           @db.Decimal(18, 0)
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(18, 0)
  status          TransactionStatus @default(COMPLETED)
  description     String?           @db.VarChar(250)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  account  BankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer Transfer?   @relation(fields: [transferId], references: [id])

  @@unique([transferId, transactionType], name: "uq_transfer_transaction_type")
  @@index([accountId, createdAt(sort: Desc), id(sort: Desc)], name: "idx_transactions_account_created")
  @@map("financial_transactions")
}

model Transfer {
  id                   String         @id @default(uuid())
  sourceAccountId      String         @map("source_account_id")
  destinationAccountId String         @map("destination_account_id")
  initiatedByUserId    String         @map("initiated_by_user_id")
  amount               Decimal        @db.Decimal(18, 0)
  description          String?        @db.VarChar(250)
  idempotencyKey       String         @map("idempotency_key") @db.VarChar(128)
  status               TransferStatus @default(COMPLETED)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  sourceAccount      BankAccount          @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount BankAccount          @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  initiatedByUser    User                 @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  transactions       FinancialTransaction[]

  @@unique([sourceAccountId, idempotencyKey], name: "uq_transfer_idempotency")
  @@map("transfers")
}
