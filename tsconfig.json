{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "ES2022",
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "test/unit/transfer-money.use-case.spec.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "docs",
    "**/*.spec.ts",
    "prisma.config.ts"
  ]
}
